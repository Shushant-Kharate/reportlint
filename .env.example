# Cloud deployment: connect a PRIVATE Vercel Blob store to the project.
# Vercel injects BLOB_STORE_ID and short-lived OIDC credentials automatically.
REPORTLINT_CLOUD=0
# BLOB_STORE_ID=store_example
# Local development outside Vercel can instead use BLOB_READ_WRITE_TOKEN.
# Never put tokens or API credentials in Flutter build arguments.
